# Golden comparisons use the exact SVG bytes on Windows and in CI.
# Preserve upstream legal texts and their recorded hashes byte-for-byte.
licenses/** -text
THIRD_PARTY_NOTICES.md text eol=lf
Cargo.lock text eol=lf
crates/scicanvas-core/tests/golden/*.svg text eol=lf

# .scv samples are zip archives; keep their bytes untouched.
*.scv binary

# Keep NIST StRD source downloads byte-for-byte (including upstream CRLF).
crates/scicanvas-core/tests/nist/**/*.dat -text -whitespace

# Reproducible reference JSON uses LF on Windows and in CI.
crates/scicanvas-core/tests/reference/*.json text eol=lf
